<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/App_Data/Logs/nlog-internal.log">

  <variable name="logDir" value="${basedir}/App_Data/Logs" />

  <targets async="true">
    <target xsi:type="File"
            name="allFile"
            fileName="${logDir}/wsus-api-${shortdate}.log"
            archiveFileName="${logDir}/archive/wsus-api-{#}.log"
            archiveEvery="Day"
            maxArchiveFiles="30"
            layout="${longdate}|${level:uppercase=true}|${logger}|${mdlc:item=CorrelationId}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

    <target xsi:type="File"
            name="errorFile"
            fileName="${logDir}/wsus-api-errors-${shortdate}.log"
            archiveFileName="${logDir}/archive/wsus-api-errors-{#}.log"
            archiveEvery="Day"
            maxArchiveFiles="60"
            layout="${longdate}|${level:uppercase=true}|${logger}|${mdlc:item=CorrelationId}|${message}${newline}${exception:format=tostring}" />

    <target xsi:type="Trace"
            name="trace"
            layout="${longdate} [${level:uppercase=true}] ${logger}: ${message}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="allFile,trace" />
    <logger name="*" minlevel="Error" writeTo="errorFile" />
  </rules>
</nlog>
