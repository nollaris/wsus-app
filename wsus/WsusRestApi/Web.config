<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Api:SecurityConfigPath" value="Config\security.json" />
    <add key="Wsus:SettingsPath" value="Config\Wsus\wsus-settings.json" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <customErrors mode="On" />
    <httpRuntime targetFramework="4.8" maxRequestLength="4096" enableVersionHeader="false" />
  </system.web>

  <system.webServer>
    <handlers>
      <clear />
      <add name="WsusRestApiHandler" path="*" verb="GET,HEAD,POST,OPTIONS" type="WsusRestApi.WsusRouterHandler, WsusRestApi" resourceType="Unspecified" preCondition="integratedMode" />
    </handlers>
    <security>
      <requestFiltering>
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
