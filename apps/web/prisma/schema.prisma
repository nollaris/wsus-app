generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model UserActionLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  username  String
  action    String
  target    String
  details   String

  @@index([createdAt])
  @@index([username, createdAt])
}

model Classification {
  serverName       String    @default("")
  classificationId String
  title            String
  description      String
  arrivalDate      DateTime?
  releaseNotes     String?

  @@id([serverName, classificationId])
  @@index([serverName])
}

model Product {
  serverName  String    @default("")
  categoryId  String
  title       String
  type        String
  description String
  arrivalDate DateTime?

  @@id([serverName, categoryId])
  @@index([serverName])
}

model ClientStatus {
  serverName             String    @default("")
  computerTargetId       String
  computerName           String
  ipAddress              String
  osDescription          String
  osVersion              String?
  make                   String?
  model                  String?
  processorArchitecture  String?
  biosVersion            String?
  biosReleaseDate        DateTime?
  firmwareVersion        String?
  mobileOperator         String?
  clientVersion          String
  computerRole           String
  requestedTargetGroup   String?
  assignedTargetGroups   String
  lastSyncTime           DateTime?
  lastReportedStatusTime DateTime?
  installedCount         Int       @default(0)
  neededCount            Int       @default(0)
  failedCount            Int       @default(0)
  pendingRebootCount     Int       @default(0)
  notApplicableCount     Int       @default(0)
  unknownCount           Int       @default(0)

  @@id([serverName, computerTargetId])
  @@index([serverName])
  @@index([computerTargetId])
  @@index([computerName])
}

model PatchInventory {
  serverName       String    @default("")
  updateId         String
  revisionNumber   Int
  title            String
  kbArticle        String?
  products         String?
  classification   String
  arrivalDate      DateTime?
  creationDate     DateTime?
  msrcSeverity     String
  isApproved       Boolean
  isDeclined       Boolean
  isSuperseded     Boolean
  isLatestRevision Boolean
  updateType       String
  description      String

  @@id([serverName, updateId, revisionNumber])
  @@index([serverName])
  @@index([updateId])
  @@index([classification])
  @@index([msrcSeverity])
  @@index([kbArticle])
  @@index([isApproved, isDeclined])
}

model ClientPatchStatus {
  id                    Int     @id @default(autoincrement())
  serverName            String  @default("")
  computerName          String
  computerTargetId      String
  ipAddress             String
  updateId              String
  revisionNumber        Int
  updateTitle           String
  kbArticle             String?
  classification        String
  installationState     String
  approvalAction        String
  approvalTargetGroupId String
  errorCode             String?
  errorMessage          String?

  @@index([serverName])
  @@index([computerTargetId])
  @@index([updateId])
  @@index([installationState])
  @@index([classification])
  @@index([kbArticle])
}

model SynchronizationHistory {
  serverName        String    @default("")
  synchronizationId String
  startTime         DateTime?
  endTime           DateTime?
  result            String
  startedManually   Boolean
  updateErrors      String?
  error             String?
  errorText         String?

  @@id([serverName, synchronizationId])
  @@index([serverName])
  @@index([startTime])
}

model SynchronizationSetting {
  serverName               String    @id
  synchronizeAutomatically Boolean
  synchronizationTimeUtc   String
  synchronizationTimeLocal String
  syncPerDay               Int
  intervalHours            Int
  lastModifiedBy           String
  lastModifiedTime         DateTime?
}

model WsusServer {
  id                Int                    @id @default(autoincrement())
  name              String
  baseUrl           String                 @unique
  apiKey            String
  enabled           Boolean                @default(true)
  lastSyncedAt      DateTime?
  lastStatus        String?
  lastError         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  approvalSchedules WsusApprovalSchedule[]
}

model WsusApprovalSchedule {
  id              Int        @id @default(autoincrement())
  serverId        Int
  updateId        String
  revisionNumber  Int
  updateTitle     String
  targetGroupId   String
  targetGroupName String
  scheduledAt     DateTime
  status          String     @default("pending")
  createdBy       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  executedAt      DateTime?
  error           String?
  server          WsusServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, status, scheduledAt])
  @@index([status, scheduledAt])
}
